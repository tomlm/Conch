<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <AssemblyName>Conch</AssemblyName>
    <Product>Conch</Product>
    <Authors>Tom Laird-McConnell</Authors>
  </PropertyGroup>

  <!-- Conch ships as a .NET global tool. Distro packaging lives in Conchix,
       which is free to acquire it however suits an image. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>conch</ToolCommandName>
    <PackageId>Conch</PackageId>
    <IsPackable>true</IsPackable>
    <Title>Conch</Title>
    <Description>A TUI application shell: a windowing environment for terminal apps. Hosts multiple XTerm terminal windows in a single console session, with applications described by YAML registration files.</Description>
    <PackageTags>tui;terminal;console;shell;window-manager;avalonia;consolonia;xterm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tomlm/Conch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tomlm/Conch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Consolonia" Version="12.0.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Consolonia.ManagedWindows" Version="12.0.3.13" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="4.0.3" />
    <PackageReference Include="Iciclecreek.Avalonia.WindowManager" Version="5.0.2" />
    <PackageReference Include="ObjectSearch.Net" Version="1.2.0" />
    <PackageReference Include="YamlConvert" Version="3.1.0" />
  </ItemGroup>

  <!-- Ship the app registrations next to the executable so the catalog is populated
       on a machine that has never reached the remote feed. -->
  <ItemGroup>
    <!-- Pack="false" keeps these out of content/ and contentFiles/, which mean
         nothing for a tool package. CopyToOutputDirectory still puts them in the
         publish output, which is what lands next to the executable and what
         AppContext.BaseDirectory resolves to. -->
    <Content Include="Tools\**\*.yml" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

  <!-- Avalonia drags SkiaSharp and HarfBuzz native binaries for every RID it has
       ever supported, plus their Windows debug symbols: 232MB of native code and
       300MB of .pdb, against 20MB for the rest of the app.

       Conch draws through Consolonia's console renderer, but loads Skia behind it
       (UseSkia in Program.cs) for the one thing Consolonia hands on: decoding the
       screenshots in the app manager. So libSkiaSharp stays for the platforms Conch
       runs on, and nothing else does:
         - HarfBuzz: text shaping, which Consolonia replaces with its own TextShaper.
         - Skia for every other RID (android, ios, wasm, musl, x86, ...).
         - Native debug symbols.
       NativeAssetTrimTests guards both halves. -->
  <PropertyGroup>
    <KeptSkiaRuntimes>;linux-x64;linux-arm64;win-x64;win-arm64;osx;</KeptSkiaRuntimes>
  </PropertyGroup>
  <Target Name="TrimUnusedNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NativeAsset Include="@(ResolvedFileToPublish)"
                    Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))">
        <Rid>$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Split('/')[1])</Rid>
      </_NativeAsset>
      <_TrimmedNativeAsset Include="@(_NativeAsset)"
                           Condition="$([System.String]::Copy('%(Filename)').Contains('HarfBuzz')) OR
                                      ( $([System.String]::Copy('%(Filename)').Contains('SkiaSharp')) AND
                                        ( '%(Extension)' == '.pdb' OR !$(KeptSkiaRuntimes.Contains(';%(Rid);')) ) )" />
      <ResolvedFileToPublish Remove="@(_TrimmedNativeAsset)" />
    </ItemGroup>
  </Target>

</Project>