<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Consolonia" Version="12.0.3.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Consolonia.ManagedWindows" Version="12.0.3.13" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="4.0.2" />
    <PackageReference Include="Iciclecreek.Avalonia.WindowManager" Version="5.0.1" />
    <PackageReference Include="ObjectSearch.Net" Version="1.2.0" />
    <PackageReference Include="YamlConvert" Version="3.1.0" />
  </ItemGroup>

  <!-- Ship the app registrations next to the executable so the catalog is populated
       on a machine that has never reached the remote feed. -->
  <ItemGroup>
    <Content Include="Tools\**\*.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
