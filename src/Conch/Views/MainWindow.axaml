<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:console="https://github.com/jinek/consolonia"
		xmlns:wm="clr-namespace:Iciclecreek.Avalonia.WindowManager;assembly=Iciclecreek.Avalonia.WindowManager"
		xmlns:controls="clr-namespace:Conch.Controls"
		xmlns:vm="clr-namespace:Conch.ViewModel"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Conch.Views.MainWindow"
		RequestedThemeVariant="Dark"
		Title="Conch">
	<Window.Styles>
		<Style Selector="Button.window.attention">
			<Setter Property="Foreground" Value="{DynamicResource ThemeErrorBrush}"/>
		</Style>
		<Style Selector="Button.window.active">
			<Setter Property="Background" Value="{DynamicResource ThemeSelectionBackgroundBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource ThemeSelectionForegroundBrush}"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<!--
		One row, the three things every desktop has: a place to start things (the Conch menu
		and the search box), what is open (the window list), and status. On a console every
		row is the user's, so the bar takes one.
		-->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto">

			<!--
			Everything that is not an app, behind one icon: the Start button, the Apple menu.
			Apps are found by searching, so Files and Terminal are not here.
			-->
			<Menu Grid.Column="0">
				<MenuItem x:Name="ConchMenu" ToolTip.Tip="Conch">
					<!-- Groups: apps, settings, about, session. -->
					<MenuItem Header="_Software..." Click="OnManageApps"/>
					<Separator/>
					<!--
					Each opens whatever serves the role (Conch's own Network, Conchix Display,
					pulsemixer) and offers Preferences when nothing does.
					-->
					<MenuItem Header="_Network..." Click="OnShowNetwork"/>
					<MenuItem Header="_Display..." Click="OnShowDisplay"/>
					<MenuItem Header="A_udio..." Click="OnShowAudio"/>
					<MenuItem Header="_Preferences..." Click="OnShowSettings"/>
					<Separator/>
					<MenuItem Header="_About Conch" Click="OnShowAbout"/>
					<Separator/>
					<!--
					Restart and Shut Down appear only when Conch was started as the session, so
					a misclick on a machine that is merely running Conch cannot reboot it. See
					CommandLineOptions.SessionFlag.
					-->
					<MenuItem x:Name="LogoutItem" Header="_Logout" Click="OnLogout"/>
					<MenuItem x:Name="RestartItem" Header="_Restart" Click="OnRestart"/>
					<MenuItem x:Name="ShutDownItem" Header="S_hut Down" Click="OnShutDown"/>
				</MenuItem>
			</Menu>

			<!--
			Search: Start-menu search, Spotlight. An icon that opens the box and its results,
			rather than a box always on screen: on an 80-column console a visible box took a
			third of the row the window list needs. Empty, it lists the installed apps; typed
			into, it finds apps, settings and commands, and offers to run anything else as a
			command line.
			-->
			<Panel x:Name="SearchArea" Grid.Column="1" Margin="1 0 1 0" x:DataType="vm:ShellSearchViewModel">
				<Button x:Name="SearchButton"
						Click="OnSearchClicked"
						Theme="{DynamicResource ThemeNakedButton}"
						ToolTip.Tip="Search apps and settings"/>
				<Popup x:Name="SearchPopup"
					   Placement="Bottom"
					   IsLightDismissEnabled="True"
					   MaxHeight="18">
					<console:BorderPanel>
						<DockPanel Width="48" Background="{DynamicResource ThemeAlternativeBackgroundBrush}">
							<TextBox x:Name="SearchBox"
									 DockPanel.Dock="Top"
									 PlaceholderText="Search or run a command"
									 Text="{Binding Query, Mode=TwoWay}"/>
							<ListBox x:Name="SearchResults"
									 ItemsSource="{Binding Results}"
									 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
									 Background="{DynamicResource ThemeAlternativeBackgroundBrush}"
									 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="vm:SearchItem">
										<Grid ColumnDefinitions="*,Auto" Background="Transparent">
											<!-- A ContextFlyout: Consolonia's theme has no template for ContextMenu. -->
											<Grid.ContextFlyout>
												<MenuFlyout>
													<MenuItem Header="{Binding PinLabel}" IsEnabled="{Binding CanPin}" Click="OnPinClicked"/>
												</MenuFlyout>
											</Grid.ContextFlyout>
											<TextBlock Grid.Column="0" Text="{Binding Title}"
													   TextTrimming="CharacterEllipsis"/>
											<TextBlock Grid.Column="1" Text="{Binding KindLabel}"
													   Margin="1 0 0 0" Opacity="0.6"/>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</DockPanel>
					</console:BorderPanel>
				</Popup>
			</Panel>

			<controls:WindowList x:Name="WindowList" Grid.Column="2"/>

			<StackPanel Grid.Column="3" Orientation="Horizontal" Margin="1 0 1 0"
						Spacing="{console:OnPlatform Default='8',Console='1'}">
				<!--
				One indicator per thing you would want to fix from here, each opening whatever
				serves its role. Audio and Display appear only when something serves them: an
				icon that only says "nothing is set up" is clutter, and Conchix has no audio.
				-->
				<Button x:Name="NetworkIndicator"
						Click="OnShowNetwork"
						Theme="{DynamicResource ThemeNakedButton}"
						ToolTip.Tip="Network"/>
				<Button x:Name="AudioIndicator"
						Click="OnShowAudio"
						IsVisible="False"
						Theme="{DynamicResource ThemeNakedButton}"
						ToolTip.Tip="Audio"/>
				<Button x:Name="DisplayIndicator"
						Click="OnShowDisplay"
						IsVisible="False"
						Theme="{DynamicResource ThemeNakedButton}"
						ToolTip.Tip="Display"/>
				<TextBlock x:Name="Clock" VerticalAlignment="Center"/>
			</StackPanel>
		</Grid>

		<wm:WindowsPanel x:Name="Windows" Background="DarkGray"/>
	</DockPanel>
</Window>
