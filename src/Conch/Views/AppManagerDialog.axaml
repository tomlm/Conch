<wm:ManagedWindow xmlns="https://github.com/avaloniaui"
				  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				  xmlns:console="https://github.com/consolonia"
				  xmlns:wm="using:Iciclecreek.Avalonia.WindowManager"
				  xmlns:vm="clr-namespace:Conch.ViewModel"
				  xmlns:controls="clr-namespace:Conch.Controls"
				  mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="40"
				  x:Class="Conch.Views.AppManagerDialog"
				  Title="Software"
				  Width="110" Height="34"
				  x:DataType="vm:AppManagerViewModel">
	<Grid Margin="{console:OnPlatform Default='16', Console='1'}" RowDefinitions="Auto,*,Auto,Auto,Auto">
		<TextBox Grid.Row="0" x:Name="SearchBox" PlaceholderText="Search apps..." Text="{Binding SearchText}"/>
		<Grid Grid.Row="1"
			  ColumnDefinitions="1*,1*" >
			<ListBox x:Name="ToolsListBox"
					 SelectionMode="Single"
					 ItemsSource="{Binding FilteredTools}"
					 SelectedItem="{Binding SelectedTool}"
					 HorizontalAlignment="Stretch"
					 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					>
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:ToolViewModel">
						<StackPanel HorizontalAlignment="Stretch" Margin="0 0 1 0">
							<StackPanel Orientation="Horizontal" Spacing="1">
								<TextBlock Text="{Binding Name}" FontWeight="Bold"/>
								<TextBlock Text="{Binding InstallStateText}" Foreground="Gray"/>
							</StackPanel>
							<TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="{Binding #ToolsListBox.Bounds.Width}"/>
							<Separator/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" >
				<ScrollViewer Grid.Column="1">
					<StackPanel Orientation="Vertical">
						<!--
						The picture first: it is what tells you whether an app is the one you were
						thinking of, faster than its description does. Height-bounded so a tall
						screenshot cannot push every detail below the fold. In a console the units
						are cells; Consolonia draws it as quad pixels (sixel when that lands).
						-->
						<Image Source="{Binding ScreenshotImage}"
							   IsVisible="{Binding HasScreenshotImage}"
							   Stretch="Uniform"
							   StretchDirection="DownOnly"
							   HorizontalAlignment="Center"
							   MaxHeight="{console:OnPlatform Default='360', Console='18'}"
							   Margin="{console:OnPlatform Default='0 0 0 8', Console='0 0 0 1'}"/>
						<TextBlock Text="{Binding ScreenshotStatus}"
								   IsVisible="{Binding !HasScreenshotImage}"
								   Foreground="Gray"
								   HorizontalAlignment="Center"
								   Margin="{console:OnPlatform Default='0 0 0 8', Console='0 0 0 1'}"/>
						<Grid x:Name="DetailsContent"
							  x:DataType="vm:ToolViewModel"
							  ColumnDefinitions="Auto,*"
							  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
							  DataContext="{Binding SelectedTool}">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" FontWeight="Bold" />
							<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" FontWeight="Bold" />
							<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" FontWeight="Bold" />
							<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallStateText}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="3" Grid.Column="0" Text="Version:" FontWeight="Bold" />
							<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Version}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" FontWeight="Bold" />
							<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="5" Grid.Column="0" Text="Keywords:" FontWeight="Bold" />
							<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding KeywordsText}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="6" Grid.Column="0" Text="Platform:" FontWeight="Bold" />
							<TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PlatformSummary}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="7" Grid.Column="0" Text="Command:" FontWeight="Bold" />
							<TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Command}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="8" Grid.Column="0" Text="Docs:" FontWeight="Bold" />
							<TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Documentation}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="9" Grid.Column="0" Text="Website:" FontWeight="Bold" />
							<TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Website}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="10" Grid.Column="0" Text="Source:" FontWeight="Bold" />
							<TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="11" Grid.Column="0" Text="Install:" FontWeight="Bold" />
							<TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Install}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="12" Grid.Column="0" Text="Uninstall:" FontWeight="Bold" />
							<TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Uninstall}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="13" Grid.Column="0" Text="Author:" FontWeight="Bold" />
							<TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding Author}" TextWrapping="Wrap"/>
							<TextBlock Grid.Row="14" Grid.Column="0" Text="License:" FontWeight="Bold" />
							<TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding License}" TextWrapping="Wrap"/>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>
		<!--
		Installs and uninstalls run here rather than in a window of their own: they are part of
		what this window is doing, and a separate window can end up behind it. A real terminal,
		because sudo, apt and nmcli all ask things. Hidden until a task starts; folds away after
		one succeeds, and stays open after one fails, which is when the output is worth reading.
		-->
		<Border Grid.Row="2"
				IsVisible="{Binding IsTaskPanelOpen}"
				BorderBrush="Gray" BorderThickness="1"
				Margin="{console:OnPlatform Default='0 8 0 0', Console='0 1 0 0'}">
			<controls:TaskTerminalPanel x:Name="TaskPanel"
										Height="{console:OnPlatform Default='220', Console='10'}"/>
		</Border>
		<TextBlock Grid.Row="3" Text="{Binding CheckStatus}" Foreground="Gray" HorizontalAlignment="Center"/>
		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
					Spacing="{console:OnPlatform Default='8',Console='1'}">
			<Button Content="RUN" Click="OnRun" IsEnabled="{Binding CanRun}"/>
			<Button Content="INSTALL" Click="OnInstall" IsEnabled="{Binding CanInstall}"/>
			<Button Content="UNINSTALL" Click="OnUninstall" IsEnabled="{Binding CanUninstall}"/>
			<Button Content="RECHECK" Click="OnRecheck" IsEnabled="{Binding CanRecheck}"/>
			<Button Content="{Binding LogButtonText}" Click="OnToggleLog" IsVisible="{Binding HasTaskOutput}"/>
			<Button Content="CLOSE" Click="OnClose"/>
		</StackPanel>
	</Grid>
</wm:ManagedWindow>
