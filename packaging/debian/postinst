#!/bin/sh
set -e

case "$1" in
    configure)
        # Registered but left disabled: taking over a tty is the
        # administrator's decision, not a side effect of installing.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
