* text=auto

# Anything that runs on Linux must keep LF. A CRLF postinst or unit file is a
# broken package: the shebang becomes "#!/bin/sh\r" and nothing executes.
*.sh              text eol=lf
*.service         text eol=lf
packaging/debian/postinst  text eol=lf
packaging/debian/prerm     text eol=lf
packaging/debian/control*  text eol=lf
packaging/debian/copyright text eol=lf

# App registrations are read on Linux too.
*.yml             text eol=lf
*.yaml            text eol=lf

# Captured system files, kept byte for byte. A fixture git has reformatted is no
# longer a capture of anything: checked out with CRLF, every line of a mount table
# ends in a filesystem type of "ext4\r" and matches nothing.
src/Conch.Tests/Fixtures/** -text

# Windows-side project files keep platform endings.
*.csproj          text
*.slnx            text
*.axaml           text
*.cs              text
